
@model PokeModel

<div class="text-center">
    <h1>Name: @Model.Name</h1>
    <h2>Id: @Model.Id</h2>
    <h2>Weight: @Model.Weight</h2>
    <h2>Order: @Model.Order</h2>
	<h2>Abilities:</h2>
	@foreach (var ability in Model.Abilities)
	{
		<h3>Ability Name: @ability.ability.name</h3>
		<h4>Is Hidden: @ability.is_hidden</h4>
	}
</div>

